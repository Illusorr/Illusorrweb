# OS and file manager artefacts
.DS_Store
._*
Thumbs.db
ehthumbs.db
desktop.ini

# Dropbox sync artefacts
.dropbox
.dropbox.attr
.dropbox.cache/
*.dbtmp
* (conflicted copy *).*
*conflicted copy*

# Editor and office lock files
~$*
*.swp
*.tmp

# Review captures generated during audits. The originals are cheap to
# regenerate and they add tens of MB per session to a repo that is already
# large. screenshots/ itself stays tracked.
screenshots/verify/

# Raw screen recordings and camera masters. GitHub hard-rejects anything over
# 100 MB, and these are sources, not deliverables: they belong in uploads/.
*.mov
uploads/_masters/**/*.mp4
